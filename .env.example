# Copy this file to .env and customize for your setup
# .env is gitignored so your personal settings won't be committed

# Experiment output directory
EXP_DIR="/path/to/your/exp/folder"

# Data directory
DATA_DIR="/path/to/your/data/folder"

# Slurm settings (for submitit)
SLURM_PARTITION="your-partition-name"
SLURM_ACCOUNT="your-account-name"  # optional, comment out if not needed
